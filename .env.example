# Server
PORT=3001

# Database
# Supports absolute paths and "~/" home-directory shorthand on Linux.
DB_PATH=~/mcp-memory/memories.db

# Optional: override the built frontend directory served by Express in production.
CLIENT_DIST=./client/dist

# Optional: usage visualization runtime paths.
USAGE_READER_PYTHON=/usr/bin/python3
USAGE_READER_SCRIPT=./server/scripts/usage_reader.py
USAGE_HISTORY_PATH=~/usage-reader/usage-history.json
USAGE_HISTORY_TZ=Asia/Singapore

# Memory write protection.
# Keep these only on the VPS. Never expose them through VITE_* or client/src.
# Cloudflare Access passes cf-access-authenticated-user-email after login.
MEMORY_ADMIN_EMAILS=your-email@example.com

# Optional command-line emergency key for curl/scripts only.
# Browser frontend should not receive this token.
MEMORY_ADMIN_TOKEN=

# Telegram Mini App authentication.
# Bot token from BotFather — used to verify initData HMAC signature.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to access the app.
TELEGRAM_ALLOWED_USER_IDS=
